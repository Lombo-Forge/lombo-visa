# Where Jellyfin answers, as seen from this app (a container name works when both share a network).
LOMBO_VISA_JELLYFIN_URL=http://jellyfin:8096
# Jellyfin: Dashboard > API Keys > +. One key per app, so you can revoke it alone.
LOMBO_VISA_JELLYFIN_API_KEY=changeme
# Optional. Any webhook that accepts JSON (Discord, Slack, or a bridge). Empty means no alerts.
LOMBO_VISA_WEBHOOK_URL=
# true = only print what would happen: nothing is sent and no session is ended. Set false after reading `plan`.
LOMBO_VISA_DRY_RUN=true
# With DRY_RUN=false: false = send alerts only; true = also end new sign-ins from abroad that have no travel window.
LOMBO_VISA_BLOCK_SESSIONS=false
# Required. ISO 3166 two-letter codes of the countries people normally sign in from, comma separated.
# The United Kingdom is GB (UK is refused). Anything else that is not an ISO code is refused too.
LOMBO_VISA_HOME_COUNTRIES=US
# Optional. Extra networks that count as home besides private and loopback ranges, e.g. a VPN range: 100.64.0.0/10
LOMBO_VISA_LAN_SUBNETS=
# Optional. Jellyfin account names (comma separated) that are never judged. Break-glass for the owner.
LOMBO_VISA_EXEMPT_USERS=
# Seconds between rounds with --loop. At least 10. A new sign-in lives until the next round, so keep it short.
LOMBO_VISA_INTERVAL_SECONDS=60
# If sign-ins from abroad are denied for more than this many different accounts in one round, end none and alert:
# it is probably a setup problem (wrong address seen, bad database). Many sessions of ONE account never trip it.
LOMBO_VISA_MAX_BLOCKS_PER_ROUND=3
# The longest travel window `lombo-visa travel add` will create, in days.
LOMBO_VISA_MAX_WINDOW_DAYS=30
# Where the country database file lives. `lombo-visa geoip update` downloads it. Never commit it.
LOMBO_VISA_GEOIP_DB=/data/dbip-country-lite.mmdb
# Optional. Download the database from this https:// address (a .mmdb.gz file) instead of the default source.
LOMBO_VISA_GEOIP_URL=
# Where the app remembers allowed devices and travel windows. Mount a writable folder at /data.
LOMBO_VISA_STATE_FILE=/data/state.json
